{
  "name": "plc-gbt-theia-ide",
  "version": "1.0.0",
  "description": "PLC-GBT Theia-based Integrated Development Environment for Industrial Automation",
  "license": "MIT",
  "author": "PLC-GBT Development Team",
  "homepage": "https://github.com/plc-gbt/plc-gbt",
  "repository": {
    "type": "git",
    "url": "https://github.com/plc-gbt/plc-gbt.git"
  },
  "bugs": {
    "url": "https://github.com/plc-gbt/plc-gbt/issues"
  },
  "keywords": [
    "plc",
    "industrial-automation",
    "theia",
    "ide",
    "ladder-logic",
    "control-systems"
  ],
  "dependencies": {
    "@theia/core": "^1.45.0",
    "@theia/filesystem": "^1.45.0",
    "@theia/workspace": "^1.45.0",
    "@theia/monaco": "^1.45.0",
    "@theia/messages": "^1.45.0",
    "@theia/terminal": "^1.45.0",
    "@theia/output": "^1.45.0",
    "@theia/preferences": "^1.45.0",
    "@theia/navigator": "^1.45.0",
    "@theia/outline-view": "^1.45.0",
    "@theia/search-in-workspace": "^1.45.0",
    "@theia/file-search": "^1.45.0",
    "@theia/markers": "^1.45.0",
    "@theia/mini-browser": "^1.45.0",
    "@theia/preview": "^1.45.0",
    "@theia/getting-started": "^1.45.0",
    "@theia/git": "^1.45.0",
    "@theia/scm": "^1.45.0",
    "@theia/debug": "^1.45.0",
    "@theia/console": "^1.45.0",
    "@theia/keymaps": "^1.45.0",
    "@theia/userstorage": "^1.45.0",
    "@theia/toolbar": "^1.45.0",
    "@theia/bulk-edit": "^1.45.0",
    "@theia/editor": "^1.45.0",
    "@theia/editor-preview": "^1.45.0",
    "@theia/variable-resolver": "^1.45.0",
    "@theia/json": "^1.45.0",
    "@theia/merge-conflicts": "^1.45.0",
    "@theia/task": "^1.45.0",
    "@theia/plugin": "^1.45.0",
    "@theia/plugin-ext": "^1.45.0",
    "@theia/plugin-ext-vscode": "^1.45.0",
    "axios": "^1.6.7",
    "ws": "^8.16.0",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react-flow-renderer": "^10.3.17",
    "monaco-languageclient": "^7.3.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@theia/cli": "^1.45.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/node": "^18.19.15",
    "@types/ws": "^8.5.10",
    "@types/lodash": "^4.14.202",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "playwright": "^1.40.1",
    "@playwright/test": "^1.40.1",
    "lighthouse": "^11.4.0",
    "axe-core": "^4.8.3",
    "@axe-core/playwright": "^4.8.3",
    "pa11y": "^7.0.0",
    "snyk": "^1.1266.0",
    "owasp-zap": "^0.2.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "build:prod": "theia build --mode production",
    "build:test": "theia build --mode test",
    "build:staging": "theia build --mode staging && npm run optimize:staging",
    "build:production": "theia build --mode production && npm run optimize:production",
    "clean": "theia clean",
    "clean:all": "rimraf node_modules && theia clean",
    "start": "theia start --hostname 0.0.0.0 --port 3000",
    "start:dev": "theia start --hostname localhost --port 3001 --plugins=local-dir:plugins",
    "start:debug": "yarn start --log-level debug",
    "watch": "theia build --watch",
    "package": "theia package",
    "download:plugins": "theia download:plugins",
    "prepare": "yarn clean && yarn build",
    
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:accessibility && npm run test:security",
    "test:unit": "jest --config=jest.config.unit.js --coverage --passWithNoTests",
    "test:integration": "jest --config=jest.config.integration.js --passWithNoTests",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:performance": "lighthouse-ci autorun && node scripts/performance-tests.js",
    "test:accessibility": "pa11y-ci --config .pa11yci.json && axe-core tests/accessibility",
    "test:security": "snyk test && npm audit --audit-level high && node scripts/security-tests.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "test:analyze-results": "node scripts/analyze-test-results.js",
    "test:validate-thresholds": "node scripts/validate-test-thresholds.js",
    
    "test:user-agent:initialize": "node tests/framework/user-agent-testing-cli.js initialize",
    "test:user-agent:schedule": "node tests/framework/user-agent-testing-cli.js schedule",
    "test:user-agent:execute": "node tests/framework/user-agent-testing-cli.js execute",
    "test:user-agent:report": "node tests/framework/user-agent-testing-cli.js report",
    "test:scenarios:list": "node tests/framework/scenario-manager.js list",
    
    "env:validate": "node scripts/validate-environment.js",
    "backend:health-check": "node scripts/backend-health-check.js",
    
    "deploy:staging": "node scripts/deploy-staging.js",
    "deploy:production": "node scripts/deploy-production.js",
    "validate:staging-deployment": "node scripts/validate-staging.js",
    "validate:production": "node scripts/validate-production.js",
    
    "notify:user-agents": "node scripts/notify-user-agents.js",
    "notify:stakeholders": "node scripts/notify-stakeholders.js",
    "notify:deployment-success": "node scripts/notify-deployment-success.js",
    
    "optimize:staging": "node scripts/optimize-staging.js",
    "optimize:production": "node scripts/optimize-production.js",
    
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    
    "security:audit": "npm audit && snyk test",
    "security:fix": "npm audit fix && snyk fix",
    
    "docs:generate": "typedoc --out docs/api src/",
    "docs:serve": "http-server docs/ -p 8080",
    
    "phase31:subphase": "node scripts/phase31-subphase-manager.js",
    "phase31:validate": "node scripts/phase31-validation.js",
    "phase31:report": "node scripts/phase31-report.js"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module",
      "backend": "lib/node/backend-module"
    }
  ],
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions-pack": "https://open-vsx.org/api/eclipse-theia/builtin-themes/1.92.2/file/eclipse-theia.builtin-themes-1.92.2.vsix"
  },
  "theia": {
    "target": "browser",
    "backend": {
      "config": {
        "watcher": {
          "verbose": true,
          "ignore": ["**/.git/**"]
        }
      }
    },
    "frontend": {
      "config": {
        "applicationName": "PLC-GBT IDE",
        "defaultTheme": "plc-gbt-dark",
        "defaultIconTheme": "plc-gbt-icons",
        "preferences": {
          "workbench.colorTheme": "plc-gbt-dark",
          "workbench.iconTheme": "plc-gbt-icons",
          "editor.fontSize": 14,
          "editor.tabSize": 2,
          "editor.wordWrap": "on",
          "files.autoSave": "afterDelay",
          "terminal.integrated.fontSize": 12
        }
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "../extensions/*"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run test:unit",
      "pre-push": "npm run test:all"
    }
  }
} 