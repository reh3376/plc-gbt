{
  "name": "plc-gbt-theia-ide",
  "version": "1.0.0",
  "description": "PLC-GBT Theia-based Integrated Development Environment for Industrial Automation",
  "license": "MIT",
  "author": "PLC-GBT Development Team",
  "homepage": "https://github.com/plc-gbt/plc-gbt",
  "repository": {
    "type": "git",
    "url": "https://github.com/plc-gbt/plc-gbt.git"
  },
  "bugs": {
    "url": "https://github.com/plc-gbt/plc-gbt/issues"
  },
  "keywords": [
    "plc",
    "industrial-automation",
    "theia",
    "ide",
    "ladder-logic",
    "control-systems"
  ],
  "dependencies": {
    "@theia/core": "^1.45.0",
    "@theia/filesystem": "^1.45.0",
    "@theia/workspace": "^1.45.0",
    "@theia/monaco": "^1.45.0",
    "@theia/messages": "^1.45.0",
    "@theia/terminal": "^1.45.0",
    "@theia/output": "^1.45.0",
    "@theia/preferences": "^1.45.0",
    "@theia/navigator": "^1.45.0",
    "@theia/outline-view": "^1.45.0",
    "@theia/search-in-workspace": "^1.45.0",
    "@theia/file-search": "^1.45.0",
    "@theia/markers": "^1.45.0",
    "@theia/mini-browser": "^1.45.0",
    "@theia/preview": "^1.45.0",
    "@theia/getting-started": "^1.45.0",
    "@theia/git": "^1.45.0",
    "@theia/scm": "^1.45.0",
    "@theia/debug": "^1.45.0",
    "@theia/console": "^1.45.0",
    "@theia/keymaps": "^1.45.0",
    "@theia/userstorage": "^1.45.0",
    "@theia/toolbar": "^1.45.0",
    "@theia/bulk-edit": "^1.45.0",
    "@theia/editor": "^1.45.0",
    "@theia/editor-preview": "^1.45.0",
    "@theia/variable-resolver": "^1.45.0",
    "@theia/json": "^1.45.0",
    "@theia/merge-conflicts": "^1.45.0",
    "@theia/task": "^1.45.0",
    "@theia/plugin": "^1.45.0",
    "@theia/plugin-ext": "^1.45.0",
    "@theia/plugin-ext-vscode": "^1.45.0",
    "axios": "^1.6.7",
    "ws": "^8.16.0",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react-flow-renderer": "^10.3.17",
    "monaco-languageclient": "^7.3.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@theia/cli": "^1.45.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/node": "^18.19.15",
    "@types/ws": "^8.5.10",
    "@types/lodash": "^4.14.202",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "scripts": {
    "build": "theia build --mode development",
    "build:prod": "theia build --mode production",
    "clean": "theia clean",
    "clean:all": "rimraf node_modules && theia clean",
    "start": "theia start --hostname 0.0.0.0 --port 3000",
    "start:dev": "theia start --hostname localhost --port 3001 --plugins=local-dir:plugins",
    "start:debug": "yarn start --log-level debug",
    "watch": "theia build --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "theia package",
    "download:plugins": "theia download:plugins",
    "prepare": "yarn clean && yarn build"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module",
      "backend": "lib/node/backend-module"
    }
  ],
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions-pack": "https://open-vsx.org/api/eclipse-theia/builtin-themes/1.92.2/file/eclipse-theia.builtin-themes-1.92.2.vsix"
  },
  "theia": {
    "target": "browser",
    "backend": {
      "config": {
        "watcher": {
          "verbose": true,
          "ignore": ["**/.git/**"]
        }
      }
    },
    "frontend": {
      "config": {
        "applicationName": "PLC-GBT IDE",
        "defaultTheme": "plc-gbt-dark",
        "defaultIconTheme": "plc-gbt-icons",
        "preferences": {
          "workbench.colorTheme": "plc-gbt-dark",
          "workbench.iconTheme": "plc-gbt-icons",
          "editor.fontSize": 14,
          "editor.tabSize": 2,
          "editor.wordWrap": "on",
          "files.autoSave": "afterDelay",
          "terminal.integrated.fontSize": 12
        }
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "../extensions/*"
  ]
} 