# AI Enhancement Framework - TypeScript/Next.js Project Configuration Template

ai_framework:
  version: "1.0.0"
  enabled: true
  mode: "{{AI_FRAMEWORK_MODE}}"  # development, testing, production
  typescript_support: true

# Project Information
project:
  name: "{{PROJECT_NAME}}"
  type: "typescript_frontend"  # typescript_frontend, nextjs_app, react_app, fullstack_app
  complexity: "{{PROJECT_COMPLEXITY}}"  # simple, moderate, complex, extensive
  domain: "{{PROJECT_DOMAIN}}"  # web, ui, dashboard, ecommerce, industrial
  framework: "{{FRONTEND_FRAMEWORK}}"  # nextjs, react, vue, angular

# AI Assistant Configuration
A:
  # TypeScript Task Orchestrator Settings
  task_orchestrator:
    enabled: true
    analysis_depth: "{{ANALYSIS_DEPTH}}"  # basic, standard, comprehensive
    methodical_approach: true
    systematic_planning: true
    domain_expertise: "{{PROJECT_DOMAIN}}"
    frontend_focus: true
    build_error_resolution: true
    max_build_iterations: 3
  
  # Memory Management
  memory:
    enabled: true
    project_scoped: true
    cross_session_persistence: true
    auto_cleanup: true
    memory_tiers:
      redis: true
      neo4j: true
      postgresql: true
      qdrant: true
    component_pattern_cache: true
    build_cache: true
  
  # Code Analysis
  code_analysis:
    enabled: true
    real_time: true
    validation_on_save: true
    hallucination_detection: true
    security_analysis: {{SECURITY_ANALYSIS}}
    performance_analysis: {{PERFORMANCE_ANALYSIS}}
    complexity_analysis: true
    typescript_strict: true
    react_best_practices: true

# Frontend Development Standards
standards:
  code_quality:
    type_hints: "required"  # TypeScript strict mode
    docstrings: "required"  # JSDoc comments
    test_coverage: {{TEST_COVERAGE}}  # Minimum 99% required
    complexity_limit: {{COMPLEXITY_LIMIT}}
    prop_types: "required"
    accessibility: "wcag_aa"
  
  documentation:
    auto_generate: true
    component_docs: true
    prop_documentation: true
    usage_examples: true
    mermaid_diagrams: true
    api_documentation: true
    readme_updates: true
  
  validation:
    syntax_checking: true
    typescript_compilation: true
    eslint_validation: true
    prettier_formatting: true
    security_analysis: {{SECURITY_ANALYSIS}}
    performance_analysis: {{PERFORMANCE_ANALYSIS}}
    accessibility_testing: true
    build_optimization: true

# Testing Configuration
testing:
  framework: "{{TESTING_FRAMEWORK}}"  # jest, vitest, playwright
  unit_tests:
    enabled: true
    coverage_threshold: 99
    frameworks: ["jest", "react-testing-library"]
  integration_tests:
    enabled: true
    coverage_threshold: 95
  e2e_tests:
    enabled: true
    framework: "{{E2E_FRAMEWORK}}"  # playwright, cypress
    coverage_threshold: 90
  accessibility_tests:
    enabled: true
    wcag_level: "AA"
    tools: ["axe-core", "lighthouse"]
  performance_tests:
    enabled: true
    metrics: ["FCP", "LCP", "CLS", "FID"]
    thresholds:
      fcp_threshold: 1500
      lcp_threshold: 2500
      cls_threshold: 0.1
      fid_threshold: 100

# Build and Deployment
build:
  framework: "{{BUILD_FRAMEWORK}}"  # next, vite, webpack
  optimization: true
  bundle_analysis: true
  tree_shaking: true
  code_splitting: true
  static_analysis: true
  error_resolution:
    enabled: true
    max_iterations: 3
    pattern_matching: true

# Development Tools Integration
tools:
  typescript:
    strict_mode: true
    no_emit_on_error: true
    incremental: true
  eslint:
    enabled: true
    extends: ["next/core-web-vitals", "@typescript-eslint/recommended"]
  prettier:
    enabled: true
    format_on_save: true
  bundler:
    analyzer: true
    optimization: true

# Industrial Control Integration (if applicable)
industrial_features:
  enabled: {{INDUSTRIAL_FEATURES}}
  control_loop_management: false
  plc_integration: false
  safety_systems: false
  process_optimization: false
  predictive_maintenance: false

# Framework Integration
framework:
  ai_enhancement: true
  auto_analysis: true
  validation_on_save: true
  memory_persistence: true
  context_awareness: true
  frontend_expertise: true
  typescript_orchestrator: true

# Multi-Tier Validation System
validation_tiers:
  tier_1_syntax:
    typescript_compilation: true
    eslint_validation: true
    prettier_formatting: true
    weight: 0.15
  tier_2_requirements:
    component_functionality: true
    prop_types_validation: true
    accessibility_compliance: true
    weight: 0.15
  tier_3_performance:
    build_optimization: true
    bundle_size_analysis: true
    runtime_performance: true
    weight: 0.15
  tier_4_accessibility:
    aria_compliance: true
    keyboard_navigation: true
    screen_reader_compatibility: true
    weight: 0.15
  tier_5_security:
    xss_prevention: true
    data_sanitization: true
    authentication_security: true
    weight: 0.15
  tier_6_mathematical:
    calculation_accuracy: true
    wolfram_alpha_validation: true
    numerical_precision: true
    weight: 0.10
  tier_7_production:
    deployment_readiness: true
    monitoring_integration: true
    error_boundary_coverage: true
    weight: 0.15

# Success Rate Requirements
success_requirements:
  minimum_test_coverage: 99
  minimum_validation_score: 95
  minimum_accessibility_score: 95
  minimum_performance_score: 90
  documentation_completeness: 100
  build_success_rate: 99

# Task Completion Enforcement
completion_enforcement:
  testing_compliance: true
  documentation_compliance: true
  validation_compliance: true
  roadmap_updates: true
  deliverable_linking: true 