# AI Enhancement Framework - Project Configuration Template

ai_framework:
  version: "1.0.0"
  enabled: true
  mode: "{{AI_FRAMEWORK_MODE}}"  # development, testing, production

# Project Information
project:
  name: "{{PROJECT_NAME}}"
  type: "{{PROJECT_TYPE}}"  # python, web_app, data_science, api_service, desktop_app, ml_project
  complexity: "{{PROJECT_COMPLEXITY}}"  # simple, moderate, complex, extensive
  domain: "{{PROJECT_DOMAIN}}"  # web, ml, data, automation, research

# AI Assistant Configuration
A:
  # Task Orchestrator Settings
  task_orchestrator:
    enabled: true
    analysis_depth: "{{ANALYSIS_DEPTH}}"  # basic, standard, comprehensive
    methodical_approach: true
    systematic_planning: true
    domain_expertise: "{{PROJECT_DOMAIN}}"
  
  # Memory Management
  memory:
    enabled: true
    project_scoped: true
    cross_session_persistence: true
    auto_cleanup: true
    memory_tiers:
      redis: true
      neo4j: true
      postgresql: true
      qdrant: true
  
  # Code Analysis
  code_analysis:
    enabled: true
    real_time: true
    validation_on_save: true
    hallucination_detection: true
    security_analysis: {{SECURITY_ANALYSIS}}
    performance_analysis: {{PERFORMANCE_ANALYSIS}}
    complexity_analysis: true

# Development Standards
standards:
  code_quality:
    type_hints: "required"  # required, recommended, optional
    docstrings: "required"
    test_coverage: {{TEST_COVERAGE}}
    complexity_limit: {{COMPLEXITY_LIMIT}}
  
  documentation:
    auto_generate: true
    mermaid_diagrams: true
    api_documentation: true
    readme_updates: true
  
  validation:
    syntax_checking: true
    security_analysis: {{SECURITY_ANALYSIS}}
    performance_analysis: {{PERFORMANCE_ANALYSIS}}
    linting: true
    formatting: true

# Testing Configuration
testing:
  framework: "pytest"
  coverage_target: {{TEST_COVERAGE}}
  test_types:
    unit: true
    integration: {{INTEGRATION_TESTS}}
    performance: {{PERFORMANCE_TESTS}}
    security: {{SECURITY_TESTS}}
  
  fixtures:
    auto_generate: true
    realistic_data: true

# Environment-Specific Settings
environments:
  development:
    memory_enabled: true
    analysis_depth: "comprehensive"
    validation_strict: false
    debug_mode: true
    
  testing:
    memory_enabled: false
    analysis_depth: "standard"
    validation_strict: true
    debug_mode: false
    
  production:
    memory_enabled: true
    analysis_depth: "basic"
    validation_strict: true
    security_enhanced: true
    debug_mode: false

# Team Collaboration (if applicable)
team:
  shared_memory: {{SHARED_MEMORY}}
  knowledge_sync: {{KNOWLEDGE_SYNC}}
  pattern_sharing: {{PATTERN_SHARING}}
  best_practices_enforcement: true
  
  # Team Standards
  standards:
    naming_conventions: "{{NAMING_CONVENTION}}"  # snake_case, camelCase, kebab-case
    import_organization: "isort"
    formatting: "black"
    linting: "{{LINTER}}"  # pylint, flake8, ruff

# Domain-Specific Rules
analysis:
  custom_rules:
    # Security patterns
    security:
      - no_hardcoded_secrets
      - validate_user_input
      - secure_database_queries
      - sanitize_outputs
      
    # Performance patterns  
    performance:
      - efficient_algorithms
      - memory_optimization
      - database_query_optimization
      - async_where_appropriate
      
    # Architecture patterns
    architecture:
      - separation_of_concerns
      - dependency_injection
      - clean_architecture
      - solid_principles
      
    # Domain-specific patterns (customize based on project type)
    domain_specific:
      {{#if_web_app}}
      - restful_api_design
      - proper_http_status_codes
      - request_validation
      - response_serialization
      {{/if_web_app}}
      
      {{#if_data_science}}
      - data_validation
      - reproducible_results
      - proper_data_splits
      - model_versioning
      {{/if_data_science}}
      
      {{#if_ml_project}}
      - feature_engineering_validation
      - model_evaluation_completeness
      - hyperparameter_documentation
      - training_reproducibility
      {{/if_ml_project}}

# Integration Settings
integrations:
  git:
    pre_commit_analysis: true
    commit_message_validation: true
    branch_naming_validation: true
    
  ci_cd:
    github_actions: {{GITHUB_ACTIONS}}
    quality_gates: true
    automated_testing: true
    deployment_validation: {{DEPLOYMENT_VALIDATION}}
    
  external_tools:
    pytest: true
    black: true
    mypy: {{TYPE_CHECKING}}
    isort: true
    docker: {{DOCKER_INTEGRATION}}
    
  monitoring:
    health_checks: {{HEALTH_MONITORING}}
    performance_monitoring: {{PERFORMANCE_MONITORING}}
    error_tracking: {{ERROR_TRACKING}}

# AI Enhancement Features
ai_features:
  code_generation:
    enabled: true
    context_aware: true
    pattern_based: true
    
  refactoring:
    enabled: true
    safety_checks: true
    test_preservation: true
    
  documentation:
    auto_generation: true
    code_comments: true
    api_docs: true
    
  testing:
    test_generation: {{TEST_GENERATION}}
    test_data_creation: true
    edge_case_detection: true

# Project-Specific Customizations
{{#if_custom_rules}}
custom:
  # Add your project-specific rules here
  specific_patterns:
    - {{CUSTOM_PATTERN_1}}
    - {{CUSTOM_PATTERN_2}}
  
  validation_rules:
    - {{CUSTOM_VALIDATION_1}}
    - {{CUSTOM_VALIDATION_2}}
  
  quality_gates:
    - {{CUSTOM_QUALITY_GATE_1}}
    - {{CUSTOM_QUALITY_GATE_2}}
{{/if_custom_rules}}

# Notification and Reporting
notifications:
  analysis_complete: {{ANALYSIS_NOTIFICATIONS}}
  quality_issues: true
  security_alerts: true
  performance_warnings: {{PERFORMANCE_NOTIFICATIONS}}
  
reporting:
  daily_summary: {{DAILY_REPORTS}}
  weekly_insights: {{WEEKLY_REPORTS}}
  quality_trends: {{TREND_ANALYSIS}}
  
# Advanced Configuration
advanced:
  parallel_analysis: true
  caching_enabled: true
  incremental_analysis: true
  background_processing: {{BACKGROUND_PROCESSING}}
  
  resource_limits:
    max_memory: "{{MAX_MEMORY}}"
    max_cpu_cores: {{MAX_CPU_CORES}}
    analysis_timeout: {{ANALYSIS_TIMEOUT}}

# Template Metadata
template:
  version: "1.0.0"
  created_date: "{{CREATION_DATE}}"
  framework_version: "1.0.0"
  last_updated: "{{LAST_UPDATED}}" 