# Development Container for PLC-GBT Phase 32
# Provides full access to all databases and development tools

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    vim \
    nano \
    build-essential \
    postgresql-client \
    redis-tools \
    netcat-traditional \
    iputils-ping \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for TypeScript development
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Set working directory
WORKDIR /workspace

# Install Python development dependencies
RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.25.0 \
    websockets==12.0 \
    redis==5.0.1 \
    psycopg2-binary==2.9.9 \
    neo4j==5.15.0 \
    qdrant-client==1.7.0 \
    uvloop==0.19.0 \
    httpx==0.26.0 \
    python-multipart==0.0.6 \
    python-jose[cryptography]==3.3.0 \
    passlib[bcrypt]==1.7.4 \
    pyjwt==2.8.0 \
    pydantic==2.5.3 \
    pydantic-settings==2.1.0 \
    SQLAlchemy==2.0.23 \
    asyncpg==0.29.0 \
    alembic==1.13.1 \
    openai==1.3.7 \
    tiktoken==0.5.1 \
    numpy==1.26.2 \
    scipy==1.11.4 \
    scikit-learn==1.3.2 \
    pandas==2.1.4 \
    matplotlib==3.8.2 \
    seaborn==0.13.0 \
    jupyter==1.0.0 \
    notebook==7.0.6 \
    ipykernel==6.27.1 \
    ipywidgets==8.1.1 \
    tqdm==4.66.1 \
    loguru==0.7.2 \
    python-dotenv==1.0.0 \
    requests==2.31.0 \
    pyyaml==6.0.1 \
    orjson==3.9.10 \
    aiohttp==3.9.1 \
    aiofiles==23.2.1 \
    tenacity==8.2.3 \
    circuitbreaker==1.3.1 \
    docker==6.1.3 \
    celery==5.3.6 \
    kafka-python==2.0.2 \
    pika==1.3.2 \
    pyarrow==14.0.1 \
    asyncio-throttle==1.0.1 \
    backoff==2.2.1 \
    retrying==1.3.4 \
    strawberry-graphql==0.219.0 \
    graphql-core==3.2.3

# Install TypeScript and Node.js dependencies
RUN npm install -g typescript @types/node ts-node nodemon

# Create project directories
RUN mkdir -p /workspace/phase32 /workspace/tests /workspace/docs

# Set environment variables
ENV PYTHONPATH=/workspace
ENV NODE_PATH=/usr/local/lib/node_modules

# Default command
CMD ["bash"] 