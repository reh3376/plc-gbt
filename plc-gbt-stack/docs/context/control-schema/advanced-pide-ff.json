{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Function Block Advanced PIDE (Feedforward)",
    "description": "Schema for a PIDE controller with feedforward compensation. An external feedforward value (FF) is added to the PID output to preemptively counteract disturbances:contentReference[oaicite:155]{index=155}.",
    "type": "object",
    "properties": {
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string" },
      "version": { "type": "string", "enum": ["00.00.001"] },
      "PV": { "type": "number", "description": "Process Variable (EU)."},
      "PVFault": { "type": "boolean", "description": "PV fault flag."},
      "PVEUMax": { "type": "number", "description": "PV EU max.", "default": 100.0 },
      "PVEUMin": { "type": "number", "description": "PV EU min.", "default": 0.0 },
      "SPProg": { "type": "number", "description": "Program setpoint (EU)." },
      "SPOper": { "type": "number", "description": "Operator setpoint (EU)." },
      "SPHLimit": { "type": "number", "description": "SP high limit (EU).", "default": 100.0 },
      "SPLLimit": { "type": "number", "description": "SP low limit (EU).", "default": 0.0 },
      "CVFault": { "type": "boolean", "description": "CV fault flag." },
      "CVProg": { "type": "number", "description": "Program manual CV (%).", "minimum": 0.0, "maximum": 100.0 },
      "CVOper": { "type": "number", "description": "Operator manual CV (%).", "minimum": 0.0, "maximum": 100.0 },
      "CVOverride": { "type": "number", "description": "Override CV (%).", "minimum": 0.0, "maximum": 100.0 },
      "CVEUMax": { "type": "number", "description": "CV EU max.", "default": 100.0 },
      "CVEUMin": { "type": "number", "description": "CV EU min.", "default": 0.0 },
      "CVHLimit": { "type": "number", "description": "CV high limit (%).", "default": 100.0 },
      "CVLLimit": { "type": "number", "description": "CV low limit (%).", "default": 0.0 },
      "CVROCLimit": { "type": "number", "description": "CV ROC limit (%/s).", "minimum": 0.0, "default": 0.0 },
      "FF": {
        "type": "number",
        "description": "Feedforward input (%):contentReference[oaicite:156]{index=156}. This value is added to the controller output (after deadband and output limiting). Range -100 to 100, where 0 means no feedforward correction. If out of range, it is clamped and flagged:contentReference[oaicite:157]{index=157}.",
        "minimum": -100.0,
        "maximum": 100.0,
        "default": 0.0
      },
      "FFPrevious": {
        "type": "number",
        "description": "Previous feedforward value (FFₙ₋₁) for manual initialization:contentReference[oaicite:158]{index=158}. If `FFSetPrevious` is true, the PIDE will preload the last FF value from this property instead of using its internally stored value.",
        "minimum": -100.0,
        "maximum": 100.0,
        "default": 0.0
      },
      "FFSetPrevious": {
        "type": "boolean",
        "description": "Use FFPrevious flag:contentReference[oaicite:159]{index=159}. True = replace the internally remembered last FF with the value in FFPrevious (typically used to preset the feedforward term on loop startup or mode change). Default false.",
        "default": false
      },
      "ControlAction": { "type": "string", "enum": ["Direct", "Reverse"], "description": "Control action.", "default": "Reverse" },
      "DependIndepend": { "type": "boolean", "description": "Dependent/Independent gain mode.", "default": false },
      "PGain": { "type": "number", "description": "Proportional gain.", "minimum": 0.0, "default": 0.0 },
      "IGain": { "type": "number", "description": "Integral gain (or Ti).", "minimum": 0.0, "default": 0.0 },
      "DGain": { "type": "number", "description": "Derivative gain (or Td).", "minimum": 0.0, "default": 0.0 },
      "PVEProportional": { "type": "boolean", "description": "Proportional on PV.", "default": false },
      "PVEDerivative": { "type": "boolean", "description": "Derivative on PV.", "default": true },
      "DSmoothing": { "type": "boolean", "description": "Derivative smoothing.", "default": false },
      "PVTracking": { "type": "boolean", "description": "PV tracking.", "default": false },
      "ZCDeadband": { "type": "number", "description": "Zero-crossing deadband (EU).", "minimum": 0.0, "default": 0.0 },
      "ZCOff": { "type": "boolean", "description": "Disable zero-crossing logic.", "default": false },
      "PVHHLimit": { "type": "number", "description": "PV HH alarm (EU)." },
      "PVHLimit": { "type": "number", "description": "PV High alarm (EU)." },
      "PVLLimit": { "type": "number", "description": "PV Low alarm (EU)." },
      "PVLLLimit": { "type": "number", "description": "PV LL alarm (EU)." },
      "PVDeadband": { "type": "number", "description": "PV alarm deadband (EU).", "minimum": 0.0, "default": 0.0 },
      "PVROCPosLimit": { "type": "number", "description": "PV +ROC alarm (EU/s).", "minimum": 0.0, "default": 0.0 },
      "PVROCNegLimit": { "type": "number", "description": "PV -ROC alarm (EU/s).", "minimum": 0.0, "default": 0.0 },
      "PVROCPeriod": { "type": "number", "description": "PV ROC period (s)." },
      "DevHHLimit": { "type": "number", "description": "Dev HH alarm (EU).", "minimum": 0.0 },
      "DevHLimit": { "type": "number", "description": "Dev High alarm (EU).", "minimum": 0.0 },
      "DevLLimit": { "type": "number", "description": "Dev Low alarm (EU).", "minimum": 0.0 },
      "DevLLLimit": { "type": "number", "description": "Dev LL alarm (EU).", "minimum": 0.0 },
      "DevDeadband": { "type": "number", "description": "Deviation alarm deadband (EU).", "minimum": 0.0, "default": 0.0 },
      "AllowCasRat": { "type": "boolean", "description": "Allow Cascade/Ratio (should remain false for non-cascade use).", "default": false },
      "ManualAfterInit": { "type": "boolean", "description": "Manual after init flag.", "default": false },
      "ProgProgReq": { "type": "boolean", "description": "Program request Program control.", "default": false },
      "ProgOperReq": { "type": "boolean", "description": "Program request Operator control.", "default": false },
      "ProgAutoReq": { "type": "boolean", "description": "Program request Auto mode.", "default": false },
      "ProgManualReq": { "type": "boolean", "description": "Program request Manual mode.", "default": false },
      "ProgCasRatReq": { "type": "boolean", "description": "Program request Cascade mode (unused here).", "default": false },
      "ProgOverrideReq": { "type": "boolean", "description": "Program request Override mode.", "default": false },
      "ProgHandReq": { "type": "boolean", "description": "Program request Hand mode.", "default": false },
      "OperProgReq": { "type": "boolean", "description": "Operator request Program control.", "default": false },
      "OperOperReq": { "type": "boolean", "description": "Operator request Operator control.", "default": false }
    },
    "required": [
      "created_at", "created_by", "version",
      "PV", "PVEUMax", "PVEUMin",
      "PGain", "IGain", "DGain"
    ]
  }
  