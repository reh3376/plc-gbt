{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Function Block Advanced PIDE (Cascade + Feedforward)",
    "description": "Schema for a cascaded PIDE with feedforward. The secondary PIDE uses Cascade mode and has a feedforward bias input for measured disturbances:contentReference[oaicite:201]{index=201}.",
    "type": "object",
    "properties": {
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string" },
      "version": { "type": "string", "enum": ["00.00.001"] },
      "PV": { "type": "number", "description": "PV (EU) of this controller." },
      "PVFault": { "type": "boolean" },
      "PVEUMax": { "type": "number", "default": 100.0 },
      "PVEUMin": { "type": "number", "default": 0.0 },
      "SPProg": { "type": "number" },
      "SPOper": { "type": "number" },
      "SPCascade": { "type": "number", "description": "Cascade setpoint input (EU). Default 0.0." },
      "SPHLimit": { "type": "number", "default": 100.0 },
      "SPLLimit": { "type": "number", "default": 0.0 },
      "UseRatio": { "type": "boolean", "default": false },
      "RatioProg": { "type": "number", "default": 1.0 },
      "RatioOper": { "type": "number", "default": 1.0 },
      "RatioHLimit": { "type": "number", "default": 1.0 },
      "RatioLLimit": { "type": "number", "default": 1.0 },
      "CVFault": { "type": "boolean" },
      "CVInitReq": { "type": "boolean", "default": false },
      "CVInitValue": { "type": "number", "default": 0.0 },
      "CVProg": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
      "CVOper": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
      "CVOverride": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
      "CVPrevious": { "type": "number", "default": 0.0 },
      "CVSetPrevious": { "type": "boolean", "default": false },
      "CVManLimiting": { "type": "boolean", "default": false },
      "CVEUMax": { "type": "number", "default": 100.0 },
      "CVEUMin": { "type": "number", "default": 0.0 },
      "CVHLimit": { "type": "number", "default": 100.0 },
      "CVLLimit": { "type": "number", "default": 0.0 },
      "CVROCLimit": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "WindupHIn": { "type": "boolean", "default": false },
      "WindupLIn": { "type": "boolean", "default": false },
      "FF": { "type": "number", "description": "Feedforward bias (%) added to CV:contentReference[oaicite:202]{index=202}.", "minimum": -100.0, "maximum": 100.0, "default": 0.0 },
      "FFPrevious": { "type": "number", "minimum": -100.0, "maximum": 100.0, "default": 0.0 },
      "FFSetPrevious": { "type": "boolean", "default": false },
      "ControlAction": { "type": "string", "enum": ["Direct", "Reverse"], "default": "Reverse" },
      "DependIndepend": { "type": "boolean", "default": false },
      "PGain": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "IGain": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "DGain": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "PVEProportional": { "type": "boolean", "default": false },
      "PVEDerivative": { "type": "boolean", "default": true },
      "DSmoothing": { "type": "boolean", "default": false },
      "PVTracking": { "type": "boolean", "default": false },
      "ZCDeadband": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "ZCOff": { "type": "boolean", "default": false },
      "PVHHLimit": { "type": "number" },
      "PVHLimit": { "type": "number" },
      "PVLLimit": { "type": "number" },
      "PVLLLimit": { "type": "number" },
      "PVDeadband": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "PVROCPosLimit": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "PVROCNegLimit": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "PVROCPeriod": { "type": "number" },
      "DevHHLimit": { "type": "number", "minimum": 0.0 },
      "DevHLimit": { "type": "number", "minimum": 0.0 },
      "DevLLimit": { "type": "number", "minimum": 0.0 },
      "DevLLLimit": { "type": "number", "minimum": 0.0 },
      "DevDeadband": { "type": "number", "minimum": 0.0, "default": 0.0 },
      "AllowCasRat": { "type": "boolean", "description": "Allow cascade mode.", "default": true },
      "ManualAfterInit": { "type": "boolean", "default": false },
      "ProgProgReq": { "type": "boolean", "default": false },
      "ProgOperReq": { "type": "boolean", "default": false },
      "ProgAutoReq": { "type": "boolean", "default": false },
      "ProgManualReq": { "type": "boolean", "default": false },
      "ProgCasRatReq": { "type": "boolean", "default": false },
      "ProgOverrideReq": { "type": "boolean", "default": false },
      "ProgHandReq": { "type": "boolean", "default": false },
      "OperProgReq": { "type": "boolean", "default": false },
      "OperOperReq": { "type": "boolean", "default": false },
      "OperCasRatReq": { "type": "boolean", "default": false }
    },
    "required": [
      "created_at", "created_by", "version",
      "PV", "PVEUMax", "PVEUMin",
      "PGain", "IGain", "DGain",
      "AllowCasRat"
    ]
  }
  