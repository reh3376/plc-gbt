# PLC-GPT Stack Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id
OPENAI_MODEL=gpt-4-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Neo4j Configuration  
NEO4J_PASSWORD=your-secure-neo4j-password
NEO4J_USER=neo4j
NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_BACKUP_PATH=/var/lib/neo4j/backup

# Vector Database Configuration (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=plc_embeddings

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_BEARER_TOKEN=your-secure-bearer-token-here
GATEWAY_CORS_ORIGINS=https://chat.openai.com,https://gateway.yourcorp.com

# ETL Worker Configuration
ETL_BATCH_SIZE=100
ETL_WORKER_THREADS=4
ETL_LOG_LEVEL=INFO

# Security Configuration
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Database Configuration
POSTGRES_DB=plc_metadata
POSTGRES_USER=plc_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
MASTER_KG_SYNC_URL=https://master-kg.yourcorp.com/sync
MASTER_KG_API_KEY=your-master-kg-api-key

# Development Settings
DEBUG=false
ENVIRONMENT=production
