# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_BEARER_TOKEN=your-secure-bearer-token-here
GATEWAY_CORS_ORIGINS=https://chat.openai.com,https://gateway.yourcorp.com

# ETL Worker Configuration
ETL_BATCH_SIZE=100
ETL_WORKER_THREADS=4
ETL_LOG_LEVEL=INFO

# Security Configuration
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
MASTER_KG_SYNC_URL=https://master-kg.yourcorp.com/sync
MASTER_KG_API_KEY=your-master-kg-api-key

# Development Settings
DEBUG=false
ENVIRONMENT=production

VAULT_ROOT_TOKEN=dev-vault-token
VAULT_TOKEN=dev-vault-token

JWT_SECRET=dev-jwt-secret-key-for-plc-gbt
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

GATEWAY_PORT=8080
GATEWAY_BEARER_TOKEN=dev-bearer-token
GATEWAY_CORS_ORIGINS=*

ETL_BATCH_SIZE=1000
ETL_WORKER_THREADS=4
ETL_LOG_LEVEL=info
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# N8N Configuration
N8N_API_KEY=n8n-api-key-2025
N8N_MCP_AUTH_TOKEN=n8n-mcp-auth-token-2025
N8N_DB_SCHEMA=n8n
N8N_LICENSE_KEY=d6bc4a2a-e369-489b-aaa2-8b6c4e6083cc

# N8N Advanced Configuration
N8N_RUNNERS_ENABLED=true
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=plc_gbt
DB_POSTGRESDB_USER=plc_user
DB_POSTGRESDB_PASSWORD=postgres_password
DATABASE_URL=postgresql://plc_user:postgres_password@localhost:5432/plc_gbt
FILE_STORAGE_ROOT=./file-storage

