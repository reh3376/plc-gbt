{
  "name": "PLC Memory Operations Template",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "When clicking \"Test workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "database": "postgresql",
        "operation": "query",
        "query": "SELECT * FROM plc_memory_entities WHERE entity_type = 'control_loop' LIMIT 5;"
      },
      "id": "plc-memory-query",
      "name": "Query PLC Memory",
      "type": "plc-gbt-stack.plcMemory",
      "typeVersion": 1,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "operation": "control_analysis",
        "processDescription": "{{$json[\"result\"][\"rows\"][0][\"description\"]}}",
        "modelSelection": "ft:gpt-4o-mini-2024-07-18:whiskey-house:industrial-control:But1jpnl",
        "temperature": 0.3,
        "maxTokens": 1000,
        "enableSafetyValidation": true,
        "includeConfidence": true,
        "responseFormat": "structured"
      },
      "id": "llm-analysis",
      "name": "Industrial LLM Analysis",
      "type": "plc-gbt-stack.plcIndustrialLLM",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "serverUrl": "opc.tcp://localhost:4840",
        "operation": "read",
        "nodeIds": "ns=2;s=Temperature\nns=2;s=Pressure\nns=2;s=FlowRate",
        "securityMode": "None",
        "includeTimestamps": true,
        "includeQuality": true
      },
      "id": "opcua-read",
      "name": "Read PLC Data",
      "type": "plc-gbt-stack.plcOPCUA",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "database": "redis",
        "operation": "set",
        "key": "workflow:{{$now}}:analysis",
        "value": "{{$json[\"response\"][\"content\"]}}"
      },
      "id": "cache-results",
      "name": "Cache Analysis Results",
      "type": "plc-gbt-stack.plcMemory",
      "typeVersion": 1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "When clicking \"Test workflow\"": {
      "main": [
        [
          {
            "node": "Query PLC Memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query PLC Memory": {
      "main": [
        [
          {
            "node": "Industrial LLM Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Industrial LLM Analysis": {
      "main": [
        [
          {
            "node": "Read PLC Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read PLC Data": {
      "main": [
        [
          {
            "node": "Cache Analysis Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "plc-gbt-n8n-instance"
  },
  "id": "plc-memory-template",
