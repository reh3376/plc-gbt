{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:tp": "next dev --turbopack",
    "api:gen:types": "openapi-typescript src/api/openapi.json -o src/api/types.gen.ts",
    "api:gen:zod": "node scripts/generate-api-schemas.js",
    "api:gen": "npm run api:gen:types && npm run api:gen:zod",
    "api:validate": "echo 'OpenAPI validation placeholder' || true",
    "docs:generate": "npx tsx scripts/generate-node-docs.ts",
    "docs:dev": "npm run docs:generate && npm run dev",
    "node:create": "npx tsx scripts/node-template-cli.ts create",
    "node:batch": "npx tsx scripts/node-template-cli.ts batch",
    "node:templates": "npx tsx scripts/node-template-cli.ts templates",
    "node:validate": "npx tsx scripts/node-template-cli.ts validate",
    "node:stats": "npx tsx scripts/node-template-cli.ts stats",
    "node:help": "npx tsx scripts/node-template-cli.ts help",
    "test:enhanced-modal": "npx tsx src/tests/run-enhanced-modal-tests.ts",
    "test:enhanced-modal-safe": "npx playwright test src/tests/enhanced-modal-drag-resize.test.ts --project=chromium --workers=1 --timeout=60000",
    "test:workflow-help-modal": "npx tsx scripts/run-workflow-help-modal-tests.ts",
    "test:workflow-help-modal-playwright": "npx playwright test src/tests/workflow-help-modal-comprehensive.test.ts --project=chromium --workers=1 --timeout=30000",
    "test:workflow-help-modal-mcp": "PLAYWRIGHT_BASE_URL=http://host.docker.internal:3000 npx playwright test src/tests/workflow-help-modal-comprehensive.test.ts --project=chromium --workers=1",
    "docker:setup": "npx tsx ../scripts/docker-environment-setup.ts",
    "docker:validate": "npx tsx ../scripts/validate-mcp-connectivity.ts",
    "docker:start": "cd .. && docker-compose up -d",
    "docker:stop": "cd .. && docker-compose down",
    "docker:status": "cd .. && docker-compose ps",
    "docs:generate-prototypes": "npx tsx src/docs/generate-prototype-documentation.ts",
    "docs:validate": "npx tsx src/docs/validate-documentation.ts",
    "docs:build-all": "npm run docs:generate-prototypes && npm run docs:validate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.8.2",
    "@xyflow/system": "^0.0.66",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "immer": "^10.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.4.2-canary.15",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "^4.0.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/chart.js": "^2.9.41",
    "@types/dagre": "^0.7.53",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dnd": "^2.0.36",
    "@types/react-dnd-html5-backend": "^3.0.2",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "jest-environment-jsdom": "^30.0.5",
    "openapi-typescript": "^7.9.1",
    "openapi-zod-client": "^1.18.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
