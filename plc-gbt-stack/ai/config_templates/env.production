# Production Environment Configuration
# Optimized for reliability and performance

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Memory System (production settings)
ENABLE_MEMORY=true
REDIS_URL=redis://prod-redis:6379/0
NEO4J_URI=bolt://prod-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PROD_PASSWORD}
POSTGRES_DSN=postgresql://prod_user:${DB_PROD_PASSWORD}@prod-db:5432/orchestrator_prod
QDRANT_URL=http://prod-qdrant:6333

# Features (production settings)
ENABLE_MATH_VALIDATION=true
ENABLE_PRODUCTION_CHECKS=true  # Auto-enabled in production
ENABLE_CONTROL_ANALYSIS=true
ENABLE_LLM_INTEGRATION=true

# Performance (optimized for production)
MAX_WORKERS=8
TIMEOUT_SECONDS=300
CACHE_TTL=3600
MAX_RETRIES=3

# Logging (production settings)
USE_STRUCTLOG=true
LOG_FILE=/var/log/orchestrator/production.log

# API Keys (from secure storage)
WOLFRAM_ALPHA_API_KEY=${WOLFRAM_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
