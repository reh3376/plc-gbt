# Test Environment Configuration
# Optimized for automated testing

# Application
ENVIRONMENT=test
DEBUG=false
LOG_LEVEL=WARNING

# Memory System (test settings - in-memory where possible)
ENABLE_MEMORY=false  # Disable for unit tests
# REDIS_URL=redis://localhost:6379/15  # Use separate Redis DB for tests
# NEO4J_URI=bolt://localhost:7687
# POSTGRES_DSN=postgresql://test:test@localhost:5432/orchestrator_test

# Features (minimal for testing)
ENABLE_MATH_VALIDATION=false
ENABLE_PRODUCTION_CHECKS=false
ENABLE_CONTROL_ANALYSIS=false
ENABLE_LLM_INTEGRATION=false

# Performance (fast test execution)
MAX_WORKERS=1
TIMEOUT_SECONDS=10
CACHE_TTL=0  # No caching in tests
MAX_RETRIES=0

# Logging (minimal output)
USE_STRUCTLOG=false
# LOG_FILE=logs/test.log
