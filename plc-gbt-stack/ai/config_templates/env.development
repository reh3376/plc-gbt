# Development Environment Configuration
# Optimized for local development and debugging

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Memory System (local development)
ENABLE_MEMORY=true
REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# POSTGRES_DSN=postgresql://dev:devpass@localhost:5432/orchestrator_dev

# Features (all enabled for testing)
ENABLE_MATH_VALIDATION=true
ENABLE_PRODUCTION_CHECKS=false
ENABLE_CONTROL_ANALYSIS=true
ENABLE_LLM_INTEGRATION=false

# Performance (optimized for development)
MAX_WORKERS=2
TIMEOUT_SECONDS=60
CACHE_TTL=300
MAX_RETRIES=1

# Logging
USE_STRUCTLOG=true
# LOG_FILE=logs/development.log
