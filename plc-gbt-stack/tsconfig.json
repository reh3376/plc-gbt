{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "ui/nextjs/src/**/*", "n8n-mcp/src/**/*"],
  "exclude": [
    "node_modules/**/*",
    "dist/**/*",
    "build/**/*",
    "coverage/**/*",
    "n8n-framework/**/*",
    "n8n-framework/",
    "**/n8n-framework/**/*",
    "**/n8n-framework/",
    "**/*.test.ts",
    "**/*.spec.ts",
    "api/**/*"
  ]
}
